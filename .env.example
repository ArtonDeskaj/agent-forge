# Agent Forge — provider configuration
# Copy this file to .env and fill in your own values.
# .env is gitignored and must NEVER be committed.

# Local Ollama (no key needed for local models):
FORGE_BASE_URL=http://localhost:11434/v1
FORGE_MODEL=qwen2.5:3b
FORGE_MAX_TOKENS=4096
FORGE_TEMPERATURE=0.2
FORGE_TIMEOUT=600

# Only for a hosted/cloud endpoint. Leave blank for local Ollama.
# FORGE_API_KEY=your-key-here

# --- Cloud example (OpenAI-compatible) ---
# FORGE_BASE_URL=https://api.openai.com/v1
# FORGE_MODEL=gpt-4o-mini
# FORGE_API_KEY=your-key-here
